{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/features/*", "@/app/*"], "message": "shared/ es la base: no puede depender de features/ ni de app/." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/app/*"], "message": "Las features no dependen de app/: declara rutas y menús en tu routes.tsx." },
              { "group": ["../../*", "../../../*"], "message": "Entre carpetas usa el alias @/ en vez de rutas relativas largas." }
            ]
          }
        ]
      }
    }
  ]
}
